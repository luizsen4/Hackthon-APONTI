# Chave da API da Anthropic (Claude). Sem ela, as rotas de IA respondem 503 e o app usa o modo manual.
ANTHROPIC_API_KEY=
# Modelo multimodal com saída JSON
ANTHROPIC_MODEL=claude-haiku-5-5
# Origem do front-end autorizada (CORS). Separe várias por vírgula.
CORS_ORIGIN=http://localhost:3000
PORT=4000
