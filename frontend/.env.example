# Endereço da API do RAIZ (pasta backend). Sem ela, a IA fica desligada e o app usa o modo manual.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Supabase. Sem estas duas variáveis, o app roda em MODO DEMONSTRAÇÃO (dados fictícios guardados no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
